# Data lake, warehouse and anything derived from a raw API pull.
# Space-Track data is covered by a US-government data-use agreement and is
# never committed or redistributed. Derived products only, published elsewhere.
/data/

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Dagster
.dagster/
dagster_home/
.tmp_dagster_home_*/
data/.dagster/
data/dagster_dev.log

# dbt
transform/target/
transform/dbt_packages/
transform/logs/
transform/.user.yml
# transform/package-lock.yml is deliberately NOT ignored: it pins the exact dbt
# package versions, for the same reason uv.lock is committed. Without it,
# `dbt deps` resolves afresh within the ranges in packages.yml and two machines
# can build the same models against different macros.

# dlt
.dlt/secrets.toml
~/.dlt/

# Terraform
infra/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Analysis outputs are regenerated by `make figures`; keep the directory only.
analysis/figures/*
!analysis/figures/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/

# Built dbt docs page (make docs-site); published by .github/workflows/docs.yml
site/
