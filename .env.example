# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.

# --- Space-Track.org --------------------------------------------------------
# Free registration: https://www.space-track.org/auth/createAccount
# Rate limits are enforced by the client, not by you: <30 req/min, <300 req/hr.
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=

# --- NASA OMNI via SPDF HAPI -----------------------------------------------
# Public, no authentication. Override only to point at a mirror.
HAPI_BASE_URL=https://cdaweb.gsfc.nasa.gov/hapi

# --- Lake -------------------------------------------------------------------
# local -> a directory on this machine, data/lake. The default.
# r2    -> an S3-compatible bucket: Cloudflare R2, or SeaweedFS from infra/docker.
#          The Docker stack sets these itself; set them here only to point the
#          uv path at a bucket (for the Docker stack's SeaweedFS from the host:
#          http://localhost:8333, atlas / atlas-local-only).
LAKE_BACKEND=local
LAKE_ENDPOINT_URL=http://localhost:8333
LAKE_BUCKET=starlink-drag-atlas
LAKE_ACCESS_KEY_ID=
LAKE_SECRET_ACCESS_KEY=
LAKE_REGION=auto

# --- Local paths ------------------------------------------------------------
DATA_DIR=data
DUCKDB_PATH=data/atlas.duckdb

# --- Pipeline ---------------------------------------------------------------
# First partition of the backfill. Starlink v1.0 launches begin 2019-11.
PIPELINE_START_DATE=2020-01-01
LOG_LEVEL=INFO
