# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.

# --- Space-Track.org --------------------------------------------------------
# Free registration: https://www.space-track.org/auth/createAccount
# Rate limits are enforced by the client, not by you: <30 req/min, <300 req/hr.
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=

# --- NASA OMNI via SPDF HAPI -----------------------------------------------
# Public, no authentication. Override only to point at a mirror.
HAPI_BASE_URL=https://cdaweb.gsfc.nasa.gov/hapi

# --- Lake -------------------------------------------------------------------
# local  -> MinIO (see infra/docker)
# prod   -> Cloudflare R2
LAKE_BACKEND=local
LAKE_ENDPOINT_URL=http://localhost:9000
LAKE_BUCKET=starlink-drag-atlas
LAKE_ACCESS_KEY_ID=
LAKE_SECRET_ACCESS_KEY=
LAKE_REGION=auto

# --- Local paths ------------------------------------------------------------
DATA_DIR=data
DUCKDB_PATH=data/atlas.duckdb

# --- Pipeline ---------------------------------------------------------------
# First partition of the backfill. Starlink v1.0 launches begin 2019-11.
PIPELINE_START_DATE=2020-01-01
LOG_LEVEL=INFO
